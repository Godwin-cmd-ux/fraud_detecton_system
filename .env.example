# Copy to .env at the repository root. Local PostgreSQL uses trust auth, so no password is needed.
DATABASE_URL=postgres://postgres@localhost:5432/fraud_detection
DATABASE_URL_TEST=postgres://postgres@localhost:5432/fraud_detection_test
SESSION_SECRET=change-me-to-a-long-random-string
ML_API_URL=http://localhost:5000
ADMIN_SETUP_KEY=AdminSetupTZ
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- USSD (Africa's Talking) -------------------------------------------------
# Shared secret the callback URL must carry, e.g.
#   https://<name>.ngrok-free.app/api/ussd/callback?token=<USSD_CALLBACK_SECRET>
USSD_CALLBACK_SECRET=ussd-dev-secret
# Optional comma-separated source IP allowlist. Leave empty when tunnelling with ngrok,
# because ngrok replaces the original caller IP with its own.
USSD_ALLOWED_IPS=
# How long a session stays resumable, in seconds (the gateway times out around 3 minutes).
USSD_SESSION_TTL_SEC=180
# Maximum callbacks accepted from one number per minute.
USSD_RATE_LIMIT_PER_MIN=30

# --- SMS (Africa's Talking) --------------------------------------------------
# Leave AT_API_KEY empty to disable sending: the API then skips SMS and logs a warning.
AT_API_KEY=
# Your app username, or `sandbox` for a sandbox app.
AT_USERNAME=sandbox
# Optional alphanumeric sender id or short code.
AT_SENDER_ID=
